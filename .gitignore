venv/
__pycache__/
*.pyc
*.pkl
nightshift/corpus.db
nightshift/meta_model.pkl
nightshift/logs/*.log
.DS_Store
*.zip
.env

# local backups & regenerating artifacts — never commit
*.bak
*.old
*.synthetic-bak
*.demo-backup
nightshift/corpus.db
nightshift/meta_model.pkl
nightshift/.run.lock/
# anchor_ots.py's confirmed-receipts cache -- pure performance hint,
# rebuildable from reports/ots/*.hash.ots themselves if lost; never a
# source of truth (core/verify_chain.py and self_audit.py each check
# the real .hash.ots bytes directly, never this file).
nightshift/logs/ots_confirmed.index

# local safety-net copies -- redundant with git history, and if they show
# up as untracked they make status.py report "uncommitted changes" on every
# single run, which trains you to ignore a line that should mean something.
*.backup
*.bak[0-9]
*.bak-*
*.pre-*-bak
